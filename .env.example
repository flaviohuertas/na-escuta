# Copie este arquivo para .env e preencha os valores. Nunca commit o .env real.

# --- Banco de dados (Postgres via docker-compose.yml) ---
DATABASE_URL="postgresql://naescuta:naescuta_dev_password@localhost:5432/naescuta?schema=public"
# Só para banco local de UMA conexão (ex.: `prisma dev`/PGlite): descomente para o pool enfileirar as consultas.
# Com Postgres de verdade (docker compose) deixe comentado.
# DATABASE_POOL_MAX=1

# --- Autenticação (Auth.js v5) ---
# Gere um valor aleatório com: npx auth secret  (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="__GERE_UM_SEGREDO_ALEATORIO__"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Grant de sessão offline (par de chaves EdDSA / Ed25519, formato JWK) ---
# Gere o par com: npm run keys:generate
# Nunca reutilize as chaves de exemplo abaixo em produção.
OFFLINE_GRANT_PRIVATE_KEY_JWK="__GERE_COM_npm_run_keys:generate__"
OFFLINE_GRANT_PUBLIC_KEY_JWK="__GERE_COM_npm_run_keys:generate__"
# Mesmo valor de OFFLINE_GRANT_PUBLIC_KEY_JWK — exposto ao cliente (chave pública não é segredo).
NEXT_PUBLIC_OFFLINE_GRANT_PUBLIC_KEY_JWK="__GERE_COM_npm_run_keys:generate__"

# Quantos dias um dispositivo pode operar offline sem revalidar a sessão online (padrão da empresa; pode ser sobrescrito por Company.offlineAccessDays)
DEFAULT_OFFLINE_ACCESS_DAYS="7"

# --- Ambiente ---
NODE_ENV="development"
